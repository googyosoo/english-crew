{
  "name": "english-crew",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for English lesson & assessment agent crew",
  "main": "desktop/main.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:electron": "electron desktop/main.js",
    "dev": "concurrently -k -n \"VITE,APP\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"wait-on tcp:127.0.0.1:5173 && electron desktop/main.js\"",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "backend\\.venv\\Scripts\\python.exe scripts/build_backend.py",
    "build": "npm run build:frontend",
    "build:all": "npm run build:frontend && backend\\.venv\\Scripts\\python.exe scripts/build_backend.py",
    "dist": "electron-builder --win --dir",
    "dist:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.englishcrew.app",
    "productName": "English Crew",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "wait-on": "^8.0.2"
  }
}
